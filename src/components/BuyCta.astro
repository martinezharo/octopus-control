---
import { AVAILABILITY, formatPrice, type Availability } from '../lib/catalog';

interface Props {
  precio: number | null;
  availability: Availability;
  fewyaUrl: string;
  /** Anchor to jump to when the product is gone and we can only offer alternatives. */
  alternativesHref?: string;
}

const { precio, availability, fewyaUrl, alternativesHref = '#alternativas' } = Astro.props;

const isBuyable = availability === AVAILABILITY.IN_STOCK;
const isArchived = availability === AVAILABILITY.ARCHIVED;

const STATUS = {
  [AVAILABILITY.IN_STOCK]: { label: 'En stock · envío en 24-48 h', tone: 'ok' },
  [AVAILABILITY.OUT_OF_STOCK]: { label: 'Agotado temporalmente', tone: 'warn' },
  [AVAILABILITY.UNLISTED]: { label: 'No disponible ahora mismo', tone: 'warn' },
  [AVAILABILITY.ARCHIVED]: { label: 'Descatalogado', tone: 'off' },
} as const;

const status = STATUS[availability];
---

<div class="buy-cta" data-availability={availability}>
  <div class="price-row">
    <div class="price-block">
      {precio !== null && <span class="price">{formatPrice(precio)}</span>}
      <span class={`status status-${status.tone}`}>
        <span class="dot" aria-hidden="true"></span>
        {status.label}
      </span>
    </div>
    {isBuyable && (
      <span class="shipping-chip">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M1 3h15v13H1zM16 8h4l3 3v5h-7"/>
          <circle cx="5.5" cy="18.5" r="2.5"/>
          <circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
        Envío gratis
      </span>
    )}
  </div>

  {isBuyable ? (
    <a
      href={fewyaUrl}
      target="_blank"
      rel="noopener"
      class="cta cta-primary"
    >
      <img src="/fewya.svg" alt="" width="22" height="22" aria-hidden="true" />
      <span>Comprar en Fewya</span>
      <svg class="cta-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 5l7 7-7 7"/>
      </svg>
    </a>
  ) : (
    <>
      <p class="unavailable-note">
        {isArchived
          ? 'Ya no trabajamos este modelo. Mantenemos la ficha publicada para que puedas identificarlo y encontrar un equivalente.'
          : 'Este mando no está disponible en este momento. Suele reponerse: guarda la página o echa un vistazo a las alternativas.'}
      </p>
      <div class="cta-row">
        <a href={alternativesHref} class="cta cta-secondary">
          <span>Ver alternativas disponibles</span>
        </a>
        <a href={fewyaUrl} target="_blank" rel="noopener" class="cta cta-ghost">
          <img src="/fewya.svg" alt="" width="18" height="18" aria-hidden="true" />
          <span>Nuestra tienda en Fewya</span>
        </a>
      </div>
    </>
  )}

  <ul class="trust">
    <li>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6L9 17l-5-5"/>
      </svg>
      Probado antes de enviar
    </li>
    <li>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
      Pago protegido por Fewya
    </li>
    <li>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
        <path d="M3 3v5h5"/>
      </svg>
      Devoluciones sin complicaciones
    </li>
  </ul>
</div>

<style>
  .buy-cta {
    background: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-xl);
    padding: var(--space-xl);
    box-shadow: var(--shadow-sm);
  }

  .price-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .price-block {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .price {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-gray-900);
    letter-spacing: -0.02em;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .status .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .status-ok { color: #0f7b52; }
  .status-ok .dot { background: #16a34a; box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.18); }

  .status-warn { color: #a16207; }
  .status-warn .dot { background: #d97706; box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.18); }

  .status-off { color: var(--color-gray-500); }
  .status-off .dot { background: var(--color-gray-400); }

  .shipping-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    background: rgba(22, 163, 74, 0.1);
    color: #0f7b52;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    width: 100%;
    padding: 15px var(--space-lg);
    border-radius: var(--radius-lg);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: background var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base), border-color var(--transition-base);
  }

  .cta-primary {
    background: var(--color-fewya);
    color: var(--color-white);
    box-shadow: 0 6px 18px rgba(91, 127, 255, 0.28);
  }

  .cta-primary:hover {
    background: var(--color-fewya-hover);
    box-shadow: 0 10px 26px rgba(91, 127, 255, 0.36);
    transform: translateY(-2px);
  }

  .cta-primary:active { transform: translateY(0); }

  .cta-arrow { transition: transform var(--transition-base); }
  .cta-primary:hover .cta-arrow { transform: translateX(3px); }

  .cta-secondary {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .cta-secondary:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
  }

  .cta-ghost {
    background: transparent;
    color: var(--color-gray-700);
    border: 1px solid var(--color-gray-200);
    font-weight: 500;
  }

  .cta-ghost:hover {
    border-color: var(--color-fewya);
    color: var(--color-fewya);
  }

  .cta-row {
    display: grid;
    gap: var(--space-sm);
  }

  .unavailable-note {
    margin-bottom: var(--space-lg);
    padding: var(--space-md);
    background: var(--color-gray-50);
    border-left: 3px solid var(--color-gray-300);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-gray-600);
  }

  .trust {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-gray-100);
    list-style: none;
  }

  .trust li {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.8125rem;
    color: var(--color-gray-600);
  }

  .trust svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta,
    .cta-arrow {
      transition: none;
    }
    .cta:hover {
      transform: none;
    }
  }
</style>
