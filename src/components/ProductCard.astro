---
import { AVAILABILITY, getImageUrl, formatPrice, isBuyable, type Producto } from '../lib/catalog';

interface Props {
  producto: Producto;
  index?: number;
}

const { producto, index = 0 } = Astro.props;
const imageUrl = producto.imagenes?.[0]
  ? getImageUrl(producto.imagenes[0])
  : '/placeholder-product.svg';

const buyable = isBuyable(producto.availability);

const UNAVAILABLE_LABEL = {
  [AVAILABILITY.OUT_OF_STOCK]: 'Agotado',
  [AVAILABILITY.UNLISTED]: 'No disponible',
  [AVAILABILITY.ARCHIVED]: 'Descatalogado',
} as const;

const unavailableLabel = buyable
  ? null
  : UNAVAILABLE_LABEL[producto.availability as keyof typeof UNAVAILABLE_LABEL];
---

<article class:list={['product-card', { 'is-unavailable': !buyable }]}>
  <a href={`/products/${producto.slug}/`} class="product-link">
    <div class="product-image">
      <img
        src={imageUrl}
        alt={producto.titulo}
        width="400"
        height="400"
        loading={index < 3 ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={index < 3 ? 'high' : 'auto'}
      />
      {producto.destacado && buyable && (
        <span class="badge badge-featured">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          Destacado
        </span>
      )}
      {unavailableLabel && <span class="badge badge-unavailable">{unavailableLabel}</span>}
      <div class="product-overlay">
        <span class="view-btn">Ver producto</span>
      </div>
    </div>

    <div class="product-info">
      {producto.categoria && (
        <span class="product-category">{producto.categoria}</span>
      )}
      <h3 class="product-title">{producto.titulo}</h3>
      <p class="product-price">
        {producto.precio !== null ? formatPrice(producto.precio) : 'Consultar'}
        {!buyable && <span class="price-note">{unavailableLabel}</span>}
      </p>
    </div>
  </a>
</article>

<style>
  .product-card {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    overflow: hidden;
    /* Resting and hover shadows are both --shadow-* pairs, so the lists have a
       matching length and interpolate cleanly. Keep it that way: adding a shadow
       to only one of the two states makes the browser pad the shorter list with
       a zero-size shadow and animate blur instead of opacity. */
    box-shadow: var(--shadow-md);
    /* Explicit properties rather than `all`: `all` also transitioned opacity,
       which competed with the reveal animation below. */
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base);
  }

  /* The entrance animation is opt-in from JS and only ever applied to cards that
     start below the fold. Cards render at their final state by default, so no
     card is ever hidden by CSS alone — a JS failure, a reduced-motion
     preference, or a card that is already visible all leave the grid painted
     immediately, which keeps LCP off the animation's critical path. */
  .product-card.is-reveal-pending {
    opacity: 0;
  }

  /* No fill-mode: once the animation ends the card falls back to its natural
     state, so the :hover lift keeps working instead of being pinned by the
     animation's final frame. */
  .product-card.is-revealing {
    animation: card-reveal 0.45s ease-out;
  }

  @keyframes card-reveal {
    from {
      opacity: 0;
      transform: translateY(16px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card.is-reveal-pending,
    .product-card.is-revealing {
      opacity: 1;
      animation: none;
    }
  }

  .product-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-xl);
  }
  
  .product-link {
    display: block;
    height: 100%;
  }
  
  .product-image {
    position: relative;
    aspect-ratio: 1/1;
    overflow: hidden;
    background: linear-gradient(135deg, var(--color-secondary-light) 0%, var(--color-secondary) 100%);
  }
  
  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }
  
  .product-card:hover .product-image img {
    transform: scale(1.08);
  }
  
  .badge {
    position: absolute;
    top: var(--space-md);
    left: var(--space-md);
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    z-index: 10;
  }

  .badge-featured {
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
    color: var(--color-white);
    box-shadow: 0 4px 12px rgba(251, 191, 36, 0.4);
  }

  .badge-unavailable {
    background: rgba(17, 24, 39, 0.82);
    color: var(--color-white);
    backdrop-filter: blur(4px);
  }

  /* Unavailable products stay in the grid and stay clickable — their pages hold
     the search history. They are just visually de-emphasised. */
  .product-card.is-unavailable .product-image img {
    filter: grayscale(0.7);
    opacity: 0.75;
  }

  .product-card.is-unavailable .product-price {
    color: var(--color-gray-500);
  }

  .price-note {
    margin-left: var(--space-sm);
    font-family: var(--font-primary);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-gray-500);
  }
  
  .product-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(3, 55, 70, 0.6);
    opacity: 0;
    transition: opacity var(--transition-base);
  }
  
  .product-card:hover .product-overlay {
    opacity: 1;
  }
  
  .view-btn {
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-white);
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: var(--radius-lg);
    transform: translateY(10px);
    transition: transform var(--transition-base);
  }
  
  .product-card:hover .view-btn {
    transform: translateY(0);
  }
  
  .product-info {
    padding: var(--space-lg);
  }
  
  .product-category {
    display: inline-block;
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-secondary-light);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-sm);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  
  .product-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-gray-800);
    margin-bottom: var(--space-sm);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .product-price {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
  }
</style>

<script>
  // Astro hoists and dedupes this script, so it runs once per page no matter how
  // many cards the grid renders.
  const REVEAL_DURATION_MS = 450;
  const STAGGER_STEP_MS = 60;
  const STAGGER_MAX_STEPS = 3;

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const setupReveal = () => {
    if (prefersReducedMotion.matches || !('IntersectionObserver' in window)) return;

    const cards = document.querySelectorAll<HTMLElement>('.product-card');
    if (cards.length === 0) return;

    // Only cards that start below the fold are hidden. Anything already on
    // screen — including the LCP candidate — is left untouched, so the animation
    // can never delay first paint of visible content.
    const viewportHeight = window.innerHeight;
    const pending = Array.from(cards).filter(
      (card) => card.getBoundingClientRect().top >= viewportHeight,
    );
    if (pending.length === 0) return;

    for (const card of pending) card.classList.add('is-reveal-pending');

    const observer = new IntersectionObserver(
      (entries) => {
        // Stagger only within the batch crossing the threshold together, capped
        // so a long scroll jump never leaves the last card waiting on a queue.
        let step = 0;

        for (const entry of entries) {
          if (!entry.isIntersecting) continue;

          const card = entry.target as HTMLElement;
          observer.unobserve(card);

          card.style.animationDelay = `${Math.min(step, STAGGER_MAX_STEPS) * STAGGER_STEP_MS}ms`;
          step += 1;

          card.classList.remove('is-reveal-pending');
          card.classList.add('is-revealing');

          // Drop the animation class so the hover transform is not competing
          // with a finished animation on the same property.
          window.setTimeout(() => {
            card.classList.remove('is-revealing');
            card.style.animationDelay = '';
          }, REVEAL_DURATION_MS + STAGGER_MAX_STEPS * STAGGER_STEP_MS);
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );

    for (const card of pending) observer.observe(card);

    // If the preference flips mid-session, stop hiding anything still queued.
    prefersReducedMotion.addEventListener('change', (event) => {
      if (!event.matches) return;
      observer.disconnect();
      for (const card of pending) card.classList.remove('is-reveal-pending', 'is-revealing');
    });
  };

  setupReveal();
</script>
